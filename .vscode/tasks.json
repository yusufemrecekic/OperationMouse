{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Unreal: Generate VS Code Project Files",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Scripts\\GenerateProjectFiles.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Unreal: Build OperationMouseEditor (Development)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Scripts\\Build.ps1",
        "-Target",
        "OperationMouseEditor",
        "-Configuration",
        "Development"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
